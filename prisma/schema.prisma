generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
  OPERATOR
  ENGINEER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  STANDBY
  AVAILABLE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum VisitCondition {
  HEALTHY
  NEEDS_ATTENTION
  CRITICAL
}

enum EquipmentCondition {
  FIXED
  NEEDS_MONITORING
  FURTHER_REPAIR_REQUIRED
}

enum ManualTestStatus {
  GOOD
  WARNING
  CRITICAL
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  plantId String?
  plant   Plant?  @relation(fields: [plantId], references: [id], onDelete: SetNull)

  assignedTickets   Ticket[]           @relation("AssignedEngineerTickets")
  passwordResetOtps PasswordResetOtp[]

  operatorTasks             Task[]             @relation("OperatorTasks")
  engineerVisitReports      VisitReport[]      @relation("EngineerVisitReports")
  engineerWorkReports       WorkReport[]       @relation("EngineerWorkReports")
  engineerManualTestResults ManualTestResult[] @relation("EngineerManualTests")
  operatorManualTestResults ManualTestResult[] @relation("OperatorManualTests")
  operatorTankerLogs        TankerLog[]        @relation("OperatorTankerLogs")
  createdTickets            Ticket[]           @relation("CreatedTickets")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([plantId])
  @@index([role])
  @@index([status])
}

model Organization {
  id                String  @id @default(cuid())
  name              String
  address           String
  contactPersonName String
  phone             String  @unique
  email             String  @unique
  organizationType  String
  gstNumber         String? @unique
  description       String?

  users     User[]
  buildings Building[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Building {
  id             String @id @default(cuid())
  name           String
  location       String
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plants       Plant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Plant {
  id                String    @id @default(cuid())
  name              String
  code              String?   @unique
  address           String
  city              String
  state             String
  pincode           String
  capacity          Float
  technology        String
  commissioningDate DateTime?
  buildingId        String

  building     Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tanks        Tank[]
  alerts       Alert[]
  tickets      Ticket[]
  users        User[]
  tasks        Task[]
  visitReports VisitReport[]
  metrics      PlantMetrics?
  tankerLogs   TankerLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, name])
  @@index([buildingId])
}

enum TankStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum SensorType {
  PH
  TSS
  BOD
  COD
  DISSOLVED_OXYGEN
  TURBIDITY
  H2S
  TEMPERATURE
}

model Tank {
  id       String     @id @default(cuid())
  name     String
  capacity Float
  status   TankStatus @default(ACTIVE)

  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  sensors           Sensor[]
  pumps             Pump[]
  manualTestResults ManualTestResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plantId, name])
  @@index([plantId])
}

model Pump {
  id                String    @id @default(cuid())
  name              String
  status            String    @default("UNKNOWN")
  brand             String?
  modelNumber       String?
  capacity          Float?
  capacityUnit      String?   @default("m³/hr")
  powerKw           Float?
  installedAt       DateTime?
  warrantyExpiresAt DateTime?
  flowRate          Float?
  pressure          Float?
  runtimeHours      Float?

  tankId String
  tank   Tank   @relation(fields: [tankId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tankId, name])
  @@index([tankId])
}

model Sensor {
  id      String     @id @default(cuid())
  name    String
  type    SensorType
  enabled Boolean    @default(true)

  minimumThreshold Float?
  maximumThreshold Float?
  unit             String?

  tankId String
  tank   Tank   @relation(fields: [tankId], references: [id], onDelete: Cascade)

  readings SensorReading[]
  alerts   Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tankId, name])
  @@index([tankId])
  @@index([type])
}

model SensorReading {
  id         String   @id @default(cuid())
  value      Float
  recordedAt DateTime @default(now())

  sensorId String
  sensor   Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId])
  @@index([recordedAt])
  @@index([sensorId, recordedAt])
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

model Alert {
  id          String        @id @default(cuid())
  title       String
  description String?
  severity    AlertSeverity
  status      AlertStatus   @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  resolvedAt  DateTime?

  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  sensorId String?
  sensor   Sensor? @relation(fields: [sensorId], references: [id], onDelete: SetNull)

  tickets Ticket[]

  @@index([plantId])
  @@index([sensorId])
  @@index([status])
  @@index([severity])
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  alertId String?
  alert   Alert?  @relation(fields: [alertId], references: [id], onDelete: SetNull)

  assignedEngineerId String?
  assignedEngineer   User?        @relation("AssignedEngineerTickets", fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  workReports        WorkReport[]

  createdById String?
  createdBy   User?   @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([plantId])
  @@index([alertId])
  @@index([assignedEngineerId])
  @@index([status])
  @@index([priority])
  @@index([createdById])
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model PasswordResetOtp {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpHash String

  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(PENDING)
  dueAt          DateTime?
  completionNote String?
  imageUrls      String[]   @default([])

  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  operatorId String
  operator   User   @relation("OperatorTasks", fields: [operatorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([operatorId])
  @@index([status])
  @@index([dueAt])
}

model VisitReport {
  id          String         @id @default(cuid())
  observation String
  condition   VisitCondition
  imageUrls   String[]       @default([])
  visitedAt   DateTime       @default(now())

  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  engineerId String
  engineer   User   @relation("EngineerVisitReports", fields: [engineerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([engineerId])
  @@index([condition])
  @@index([visitedAt])
}

model WorkReport {
  id                 String             @id @default(cuid())
  description        String
  actionsTaken       String
  partsReplaced      String?
  equipmentCondition EquipmentCondition
  imageUrls          String[]           @default([])

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  engineerId String
  engineer   User   @relation("EngineerWorkReports", fields: [engineerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticketId, engineerId])
  @@index([ticketId])
  @@index([engineerId])
  @@index([equipmentCondition])
  @@index([createdAt])
}

model PlantMetrics {
  id                String    @id
  plantId           String    @unique
  treatedWater      Float?
  flowRate          Float?
  energyConsumption Float?
  complianceScore   Int?      @default(100)
  violations        Int?      @default(0)
  lastDesludging    DateTime?
  nextDesludging    DateTime?
  sensorsOnline     Int?      @default(0)
  sensorsTotal      Int?      @default(0)

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
}

model ManualTestResult {
  id String @id @default(cuid())

  ph          Float
  bod         Float
  cod         Float
  doValue     Float
  tss         Float
  turbidity   Float
  temperature Float

  status            ManualTestStatus
  testedAt          DateTime         @default(now())
  notes             String?
  parameterStatuses Json?

  tankId String
  tank   Tank   @relation(fields: [tankId], references: [id], onDelete: Cascade)

  engineerId String?
  engineer   User?   @relation("EngineerManualTests", fields: [engineerId], references: [id], onDelete: Restrict)

  operatorId String?
  operator   User?   @relation("OperatorManualTests", fields: [operatorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tankId])
  @@index([engineerId])
  @@index([status])
  @@index([testedAt])
  @@index([tankId, testedAt])
  @@index([operatorId])
}

model ManualTestThreshold {
  parameter   String     @id
  sensorType  SensorType @unique
  goodMin     Float
  goodMax     Float
  warningMin  Float
  warningMax  Float
  criticalMin Float
  criticalMax Float
  unit        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TankerLog {
  id String @id @default(cuid())

  tankerNumber String
  agency       String
  volume       Float
  volumeUnit   String @default("kL")

  receiptImageUrl String?

  latitude  Float?
  longitude Float?

  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  operatorId String
  operator   User   @relation("OperatorTankerLogs", fields: [operatorId], references: [id], onDelete: Restrict)

  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([operatorId])
  @@index([tankerNumber])
  @@index([agency])
  @@index([loggedAt])
}
